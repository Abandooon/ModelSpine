    {
      "id": "unsupported-cycle",
      "predecessor": null,
      "edges": {"edge-ab": ["node-a", "node-b"], "edge-bc": ["node-b", "node-c"], "edge-ca": ["node-c", "node-a"]},
      "goals": [["node-a", "node-c", true]],
      "edit": "edge-ca", "sources": ["node-a"], "destinations": ["node-d"], "budget": 1,
