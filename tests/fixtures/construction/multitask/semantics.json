{
  "schema": "construction-multitask-semantics/0.1",
  "scope": "single flat graph; four nodes; existing single-edge redirect",
  "nodes": ["node-a", "node-b", "node-c", "node-d"],
  "graph": "graph",
  "root": "node-a",
  "tasks": [
    {
      "id": "fork-stage1",
